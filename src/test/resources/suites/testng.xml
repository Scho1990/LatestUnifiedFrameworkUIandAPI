<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise Automation Suite">
    <listeners>
        <listener class-name="com.enterprise.automation.listeners.TestListener"/>
        <listener class-name="com.enterprise.automation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="UI Tests">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <packages>
            <package name="com.enterprise.automation.ui.tests"/>
        </packages>
    </test>

    <test name="API Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <packages>
            <package name="com.enterprise.automation.api.tests"/>
        </packages>
    </test>
</suite>
